{
  "name": "nasiroff-content-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "vars": {
    "MAIN_CHANNEL": "@nasiroff_az",
    "TEST_CHANNEL": "-1004409605326"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CMS",
        "class_name": "CmsStore"
      }
    ]
  },
  "exports": {
    "CmsStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
